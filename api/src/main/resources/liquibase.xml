            <column name="date_voided" type="datetime"/>
            <column name="voided_reason" type="varchar(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="morgue-new-index-compartment-storage_unit-2026-09-16-11-58-40" author="walteronoh">
        <preConditions onFail="MARK_RAN">
