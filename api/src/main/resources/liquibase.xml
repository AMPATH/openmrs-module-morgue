            <column name="display" type="varchar(255)"/>
            <column name="storage_unit_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_morgue_compartment_morgue_storage_unit" references="morgue_storage_unit(storage_unit_id)" />
            </column>

            <column name="creator" type="int"/>
            <column name="date_created" type="datetime">
