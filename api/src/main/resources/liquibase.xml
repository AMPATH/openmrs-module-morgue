    <!-- Create indexes for commonly queried columns -->
    <changeSet id="morgue-new-index-patient-2024-10-06-14-21" author="pwaweru">
		<preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_morgue_deceased_patient" tableName="morgue_deceased"/>
            </not>
        </preConditions>
        <createIndex tableName="morgue_deceased" indexName="idx_morgue_deceased_patient">
            <column name="patient_id"/>
        </createIndex>
	</changeSet>

	<changeSet id="morgue-new-index-date_of_admission-2024-10-06-15-21" author="pwaweru">
		<preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_morgue_deceased_date_of_admission" tableName="morgue_deceased"/>
            </not>
        </preConditions>
        <createIndex tableName="morgue_deceased" indexName="idx_morgue_deceased_date_of_admission">
            <column name="date_of_admission"/>
        </createIndex>
    </changeSet>

    <!--Adding a new visit type named morgue-->
    <changeSet id="morgue-new-visit-type-morgue-2024-10-14-15-25" author="pwaweru">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM visit_type
                WHERE name = 'Morgue'
                And uuid = '02b67c47-6071-4091-953d-ad21452e830c'
            </sqlCheck>
        </preConditions>
        <comment>Inserting a new visit type named 'morgue' into 'visit_type' table</comment>
        <insert tableName="visit_type">
            <column name="name" value="Morgue" />
            <column name="description" value="Visit where the patient is admitted to the morgue" />
            <column name="uuid" value="02b67c47-6071-4091-953d-ad21452e830c" />

            <column name="creator" value="2" />
            <column name="date_created" valueComputed="NOW()" />
            <column name="retired" value="0" />
        </insert>
    </changeSet>

    <!-- Create morgue storage unit table -->
    <changeSet id="morgue-new-table-morgue_storage_unit-2026-09-16-11-25-38" author="walteronoh">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="morgue_storage_unit"/></not>
		</preConditions>
		<comment>
			Creating the morgue_storage_unit table
		</comment>
        <createTable tableName="morgue_storage_unit">
            <column name="storage_unit_id" autoIncrement="true" type="int">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="display" type="varchar(255)"/>
            <column name="location_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_morgue_storage_unit_location" references="location(location_id)" />
            </column>

            <column name="creator" type="int"/>
            <column name="date_created" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="int"/>
            <column name="date_changed" type="datetime"/>
            <column defaultValueBoolean="false" name="voided" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="voided_by" type="int"/>
            <column name="date_voided" type="datetime"/>
            <column name="voided_reason" type="varchar(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="morgue-new-index-storage_unit-location-2026-09-16-11-30-00" author="walteronoh">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_morgue_storage_unit_location" tableName="morgue_storage_unit"/>
            </not>
        </preConditions>
        <createIndex tableName="morgue_storage_unit" indexName="idx_morgue_storage_unit_location">
            <column name="location_id"/>
        </createIndex>
    </changeSet>

    <!-- Create morgue compartment table -->
    <changeSet id="morgue-new-table-morgue_compartment-2026-09-16-11-51-57" author="walteronoh">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="morgue_compartment"/></not>
		</preConditions>
		<comment>
			Creating the morgue_compartment table
